{
  "$ref": "#/definitions/CVProfile",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CVProfile": {
      "additionalProperties": false,
      "properties": {
        "certifications": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/Certification"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "education": {
          "items": {
            "$ref": "#/definitions/Education"
          },
          "minItems": 1,
          "type": "array"
        },
        "experiences": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/Experience"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "languages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/Language"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/definitions/ProfileDetails"
        },
        "projects": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/definitions/Project"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "skills": {
          "$ref": "#/definitions/Skills"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "profile",
        "summary",
        "education",
        "skills"
      ],
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        },
        "expiry_date": {
          "anyOf": [
            {
              "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$"
        },
        "issuer": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "issuer",
        "date"
      ],
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "degree": {
          "minLength": 1,
          "type": "string"
        },
        "end_date": {
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        },
        "field_of_study": {
          "minLength": 1,
          "type": "string"
        },
        "gpa": {
          "type": [
            "string",
            "null"
          ]
        },
        "institution": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "institution",
        "degree",
        "field_of_study",
        "end_date"
      ],
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "minItems": 1
        },
        "company": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "end_date": {
          "description": "*",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])/(19|20)\\d{2}|[Pp][Rr][Ee][Ss][Ee][Nn][Tt])$",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "minLength": 1,
          "type": "string"
        },
        "start_date": {
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|(0[1-9]|1[0-2])\\/(19|20)\\d{2})$",
          "type": "string"
        }
      },
      "required": [
        "company",
        "position",
        "start_date",
        "description"
      ],
      "type": "object"
    },
    "Language": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "proficiency": {
          "$ref": "#/definitions/LanguageProficiency"
        }
      },
      "required": [
        "language",
        "proficiency"
      ],
      "type": "object"
    },
    "LanguageProficiency": {
      "enum": [
        "Native",
        "Fluent",
        "Intermediate",
        "Basic"
      ],
      "type": "string"
    },
    "ProfileDetails": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "format": "email",
          "type": "string"
        },
        "github": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "linkedin": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "phone": {
          "minLength": 1,
          "type": "string"
        },
        "position": {
          "minLength": 1,
          "type": "string"
        },
        "seniority_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "position",
        "email",
        "phone"
      ],
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "github_url": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "live_url": {
          "format": "uri",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "technologies": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "technologies"
      ],
      "type": "object"
    },
    "Skills": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  }
}